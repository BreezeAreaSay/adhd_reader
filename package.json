{
  "name": "adhd-reader",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension: bionic-style reading on every website",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "icons": "python3 scripts/make-icons.py",
    "vendor": "node scripts/vendor-assets.js"
  },
  "devDependencies": {
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
