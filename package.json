{
  "name": "adhd-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: bionic-style reading on every website",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
